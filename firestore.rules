rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /assistentes/{owner} {
      function ownsAccount() {
        return request.auth != null && request.auth.uid == owner;
      }
      function valid() {
        return request.resource.data.keys().hasOnly(['payload', 'revision'])
          && request.resource.data.payload is string
          && request.resource.data.payload.size() < 900000
          && request.resource.data.revision is int;
      }
      allow get: if ownsAccount();
      allow create: if ownsAccount() && valid() && request.resource.data.revision == 1;
      allow update: if ownsAccount() && valid()
        && request.resource.data.revision == resource.data.revision + 1;
    }
  }
}
